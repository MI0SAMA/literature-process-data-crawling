      "note": "保留掺杂浓度和导电类型",
      "type": "映射"
    },
    {
      "original_header": "样品类型",
      "canonical_mapping": "sample_type",
      "note": "区分薄膜与器件",
      "type": "映射"
    },
    {
      "original_header": "顶电极材料",
      "canonical_mapping": "top_electrode_material",
      "note": "顶电极不要与 AlScN 溅射靶混淆",
